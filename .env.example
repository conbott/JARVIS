# Server configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Ollama Endpoint & Model Settings
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_NUM_CTX=4096

# Vector Store (Local ChromaDB)
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=rag_collection

# Pinecone Cloud Vector Store (Optional)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=attention-paper

# RAG Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
SIMILARITY_SCORE_THRESHOLD=0.35
SIMILARITY_K=4
MAX_SEARCH_RESULTS=4

# Voice Settings (Edge-TTS)
VOICE_TTS_VOICE=en-US-GuyNeural
