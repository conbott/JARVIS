# Server & Security Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=*
MAX_UPLOAD_MB=25
RATE_LIMIT_PER_MIN=0

# Provider Configuration (Defaults to 100% Local Ollama)
# Options: ollama | gemini | openai | anthropic
LLM_PROVIDER=ollama
# Options: ollama | gemini | openai
EMBEDDING_PROVIDER=ollama
# Options: chroma | pinecone
VECTOR_BACKEND=chroma
# Enable or disable voice Speech-to-Text
STT_ENABLED=true

# Model Identifiers
# Local defaults:
LLM_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Comma-separated list for dropdown model selector in API mode:
LLM_MODELS=

# Local Ollama Settings (used when provider=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=4096

# Hosted / API Provider Credentials (Optional - Env only, never logged)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Generic OpenAI-compatible base URL (e.g., https://api.deepseek.com, https://api.groq.com/openai/v1)
LLM_BASE_URL=

# Vector Storage Configuration
# Local ChromaDB directory
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=rag_collection

# Pinecone Cloud Vector Store (used when VECTOR_BACKEND=pinecone or for Chroma cloud sync)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=attention-paper

# RAG Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
SIMILARITY_SCORE_THRESHOLD=0.35
SIMILARITY_K=4
MAX_SEARCH_RESULTS=4

# Voice Settings (Edge-TTS)
VOICE_TTS_VOICE=en-US-GuyNeural
