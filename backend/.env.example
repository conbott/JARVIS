# ==========================================
# Local RAG & Voice Assistant Configuration
# ==========================================

# Server Host and Port
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Ollama Endpoint
# Default local URL: http://localhost:11434 (or your remote/network Ollama instance)
OLLAMA_BASE_URL=http://localhost:11434

# LLM Model (Works with ANY model installed in your Ollama)
# - For 6GB-8GB GPUs: qwen2.5-coder:7b, mistral:7b, llama3.1:8b, deepseek-r1:8b
# - For 4GB GPUs or CPU-only: llama3.2:3b, phi3:mini, qwen2.5:3b
# - For 12GB+ GPUs: qwen2.5-coder:14b, llama3.3:70b (quantized)
LLM_MODEL=qwen2.5-coder:7b

# Embedding Model (Runs local embeddings)
# - High accuracy: qwen3-embedding:0.6b, nomic-embed-text, bge-m3, all-minilm
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Local ChromaDB Vector Database
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=rag_collection

# Cloud Pinecone Vector Database (Optional - for cloud backup/sync)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=attention-paper

# RAG Similarity Tuning
# Threshold between 0.0 and 1.0 (recommended: 0.35)
SIMILARITY_SCORE_THRESHOLD=0.35
SIMILARITY_K=4

# Voice Synthesis (Edge-TTS - 100% CPU, 0 MB GPU overhead)
VOICE_TTS_VOICE=en-US-GuyNeural
