# ==========================================
# Local RAG & Voice Assistant Configuration
# ==========================================

# Server Host and Port
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Ollama Endpoint & Model Settings
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_NUM_CTX=4096

# Local ChromaDB Vector Database
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=rag_collection

# Cloud Pinecone Vector Database (Optional - for cloud backup/sync)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=attention-paper

# RAG Similarity Tuning
SIMILARITY_SCORE_THRESHOLD=0.35
SIMILARITY_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_SEARCH_RESULTS=4

# Voice Synthesis (Edge-TTS)
VOICE_TTS_VOICE=en-US-GuyNeural
